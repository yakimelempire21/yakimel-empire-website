{
  "name": "yakimel-os",
  "productName": "YAKIMEL OS",
  "version": "1.0.1",
  "description": "YAKIMEL OS — Yakimel Empire Command Center for Windows",
  "author": "Yakimel Empire LLC",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.yakimelempire.os",
    "productName": "YAKIMEL OS",
    "copyright": "© Yakimel Empire LLC",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "offline.html",
      "build/icon.png",
      "build/tray.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "artifactName": "YAKIMEL-OS-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "YAKIMEL OS",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "runAfterFinish": true
    },
    "publish": null
  }
}
